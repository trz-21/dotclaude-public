{
  "local": {
    "~": {
      "gmail-<ORG>-ad": {
        "oauth": {
          "callbackPort": "<SET_ME>",
          "clientId": "<SET_ME>"
        },
        "type": "http",
        "url": "https://gmailmcp.googleapis.com/mcp/v1"
      }
    },
    "<WORKSPACE>": {
      "notion": {
        "type": "http",
        "url": "https://mcp.notion.com/mcp"
      }
    },
    "<WORKSPACE>/<SERVER_REPO>": {
      "notion": {
        "type": "http",
        "url": "https://mcp.notion.com/mcp"
      }
    },
    "<WORKSPACE>/<VOICE_AGENT_REPO>": {
      "notion": {
        "type": "http",
        "url": "https://mcp.notion.com/mcp"
      }
    },
    "<WORKSPACE>/<APP_REPO>": {
      "figma": {
        "type": "http",
        "url": "http://127.0.0.1:3845/mcp"
      },
      "notion": {
        "type": "http",
        "url": "https://mcp.notion.com/mcp"
      }
    },
    "<WORKSPACE>/<ORG>-backend": {
      "notion": {
        "type": "http",
        "url": "https://mcp.notion.com/mcp"
      }
    }
  },
  "user": {
    "Sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "datadog-mcp": {
      "type": "http",
      "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp"
    },
    "gmail-<ACCOUNT>": {
      "args": [
        "-y",
        "@gongrzhe/server-gmail-autoauth-mcp@1.1.11"
      ],
      "command": "npx",
      "env": {
        "GMAIL_CREDENTIALS_PATH": "<SET_ME>",
        "GMAIL_OAUTH_PATH": "<SET_ME>"
      },
      "type": "stdio"
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "notion-<ORG>": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    }
  }
}
